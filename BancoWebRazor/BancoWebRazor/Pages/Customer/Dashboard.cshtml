@page
@model BancoWebRazor.Pages.Customer.Dashboard

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Banco Web</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/dashboard.css" rel="stylesheet">
</head>
<body class="bg-light">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="fas fa-university me-2"></i>
                Banco Web
            </a>
            <button class="btn btn-outline-danger" onclick="logout()">
                <i class="fas fa-sign-out-alt me-2"></i>Sair
            </button>
        </div>
    </nav>

    <div class="container mt-4">
        <!-- Saudação -->
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="text-dark">
                    <i class="fas fa-user-circle me-2"></i>
                    Olá, @(Model.UsuarioLogado?.Nome ?? "Usuário")!
                </h1>
                <p class="text-muted">Bem-vindo ao seu painel financeiro</p>
            </div>
        </div>

        <!-- Card de Saldo -->
        <div class="row mb-4">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card balance-card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-wallet me-2"></i>
                                Saldo Atual
                            </h5>
                            <button class="btn btn-outline-light btn-sm " onclick="toggleBalance()">
                                <i class="fas fa-eye-slash" id="toggleIcon"></i>
                            </button>
                        </div>
                        <h2 class="card-text mb-0 balance-hidden" id="balance">
                            R$ @(Model.SaldoAtual.ToString("N2"))
                        </h2>
                        <small class="opacity-75">Última atualização: hoje</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ações Rápidas -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-bolt me-2 mb-2"></i>
                            Ações Rápidas
                        </h5>
                        <div class="row">
                            <div class="col-6 col-md-3 mb-2">
                                <button class="btn btn-primary w-100 p-4" onclick="goToPayments()">
                                    <i class="fas fa-credit-card d-block mb-1"></i>
                                    Pagamentos
                                </button>
                            </div>
                            <div class="col-6 col-md-3 mb-2">
                                <button class="btn btn-outline-primary w-100 p-4">
                                    <i class="fas fa-arrow-down d-block mb-1"></i>
                                    Receber
                                </button>
                            </div>
                            <div class="col-6 col-md-3 mb-2">
                                <button class="btn btn-outline-primary w-100 p-4">
                                    <i class="fas fa-exchange-alt d-block mb-1"></i>
                                    Transferir
                                </button>
                            </div>
                            <div class="col-6 col-md-3 mb-2">
                                <button class="btn btn-outline-primary w-100 p-4">
                                    <i class="fas fa-file-invoice d-block mb-1"></i>
                                    Extrato
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Últimas Transações -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="fas fa-history me-2"></i>
                            Últimas Transações
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Data</th>
                                        <th>Descrição</th>
                                        <th>Tipo</th>
                                        <th class="text-end">Valor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.TransacoesRecentes.Any())
                                    {
                                        @foreach (var transacao in Model.TransacoesRecentes)
                                        {
                                            <tr>
                                                <td>@transacao.Data.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <i class="@transacao.Icone @(transacao.Tipo == "Crédito" ? "text-success" : "text-primary") me-2"></i>
                                                        @transacao.Descricao
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge @(transacao.Tipo == "Crédito" ? "bg-success" : "bg-danger")">
                                                        @transacao.Tipo
                                                    </span>
                                                </td>
                                                <td class="text-end @(transacao.Tipo == "Crédito" ? "text-success" : "text-danger")">
                                                    @(transacao.Valor >= 0 ? "+" : "")R$ @Math.Abs(transacao.Valor).ToString("N2")
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                <i class="fas fa-inbox fa-2x mb-2"></i>
                                                <p>Nenhuma transação encontrada</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/dashboard.js"></script>
</body>
</html>