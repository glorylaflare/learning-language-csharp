@model TesteAgencia.Models.User
@{
    ViewData["Title"] = "Detalhes do Usuário";
}
<h1>Detalhes do Usuário</h1>
<div>
    <h4>Usuário</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Nome</dt>
        <dd class = "col-sm-10">@Model.Name</dd>
        <dt class = "col-sm-2">Email</dt>
        <dd class = "col-sm-10">@Model.Email</dd>
        <dt class = "col-sm-2">Telefone</dt>
        <dd class = "col-sm-10">@Model.Phone</dd>
        <dt class = "col-sm-2">CPF</dt>
        <dd class = "col-sm-10">@Model.Cpf</dd>
        <dt class = "col-sm-2">Passaporte</dt>
        <dd class = "col-sm-10">@Model.Passport</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.UserId">Editar</a> |
    <a asp-action="Index">Voltar à lista</a>
</div>

